AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=
# Optional separate OpenAI-compatible vision endpoint. Leave blank when using text-only DeepSeek.
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_TEXT_MODEL=
# 本地 OpenAI Whisper CLI；可填写 whisper 或 whisper.exe 的绝对路径
WHISPER_EXECUTABLE=whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=Chinese
WHISPER_WORD_TIMESTAMPS=true
# 可选：固定模型缓存目录、设备（cuda/cpu）
WHISPER_MODEL_DIR=
WHISPER_DEVICE=
WHISPER_TIMEOUT_SECONDS=1800
DATA_DIR=./data
COMFY_TIMEOUT_SECONDS=7200
DEFAULT_COMFY_URL=http://127.0.0.1:8188
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
